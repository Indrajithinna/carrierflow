# Careerflow: no keys are needed for the sample workspace.
# Local server (deliberately bound to your computer only)
PORT=4310
APP_ORIGIN=http://localhost:4310
DATABASE_PATH=./data/careerflow.db

# Authentication and session configuration
REQUIRE_AUTH=true
SESSION_TTL_DAYS=7

# MongoDB Atlas user and session storage (optional, falls back to SQLite when blank)
MONGODB_URI=
MONGODB_DB_NAME=careerflow

# Amazon S3 large file and resume object storage (optional, falls back to local buffer)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT=

# Optional: Google Gemini for cover letters and research synthesis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Adzuna live job search (Remotive also works without a key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Optional: Tavily for company / interview research
TAVILY_API_KEY=

# Optional: Gmail SMTP for explicitly approved tracking emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional: choose a long random token for the browser companion.
# If blank, a local token is generated and available in Settings.
EXTENSION_TOKEN=

# Browser worker: blank uses the Playwright Chromium installed by npm run browser:install.
# Or choose an installed supported browser: chrome / msedge.
BROWSER_CHANNEL=

# Optional TTF/OTF fonts for multilingual resume PDF export (absolute paths).
# Windows Arial is used when present; otherwise PDFKit's built-in fonts are used.
RESUME_FONT_PATH=
RESUME_BOLD_FONT_PATH=
