{
  "name": "careerflow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js --production",
    "test": "node --test tests/*.test.js",
    "check": "tsc -b",
    "format": "prettier --write src server extension tests",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.5.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.11.0",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "1.1.1",
    "pdfkit": "^0.17.0",
    "playwright": "^1.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
